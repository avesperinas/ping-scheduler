# Copy to .env and fill in. .env is gitignored.

# --- Required ---

# Basic Auth credentials for the web interface. Without both, the app starts but
# answers 503 to everything: a useless app beats an open one.
PING_AUTH_USER=change-me
PING_AUTH_PASSWORD=change-me

# --- Strongly recommended ---

# Your own Claude subscription token, used only to authenticate the CLI the ping
# runs. It is passed to the subprocess and nowhere else: never stored, never
# returned by the API, never logged. Generate one with `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=

# The times you configure in the UI are local to this zone (IANA name).
SCHEDULER_TIMEZONE=UTC

# --- Optional (defaults shown) ---

# The command each ping runs. Parsed with shell quoting rules but executed
# without a shell, so pipes and redirections are not available.
# PING_COMMAND=claude -p "ok"

# A ping that does not finish in this many seconds is killed and logged failed.
# PING_TIMEOUT_SECONDS=120

# How many runs the history keeps. Older rows are pruned on every write.
# HISTORY_LIMIT=200

# How much of each run's output is stored.
# OUTPUT_EXCERPT_CHARS=2000
