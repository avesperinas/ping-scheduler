# Copy to .env and fill it in. .env is gitignored.

# Login for the web interface. Required: without both, the app answers 503.
PING_AUTH_USER=change-me
PING_AUTH_PASSWORD=change-me

# Your Claude token (`claude setup-token`). Passed only to the ping subprocess:
# never stored, never logged. Without it the app runs but every ping fails.
CLAUDE_CODE_OAUTH_TOKEN=

# Time zone your schedule is written in. IANA name, e.g. Europe/Madrid.
SCHEDULER_TIMEZONE=UTC

# --- Optional, defaults shown ---

# PING_COMMAND=claude -p "ok"     # what each ping runs (no shell: no pipes)
# PING_TIMEOUT_SECONDS=120        # a slower ping is killed and logged failed
# HISTORY_LIMIT=200               # runs kept in the history
# OUTPUT_EXCERPT_CHARS=2000       # output stored per run
